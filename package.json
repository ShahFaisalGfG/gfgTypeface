{
  "name": "gfg-typeface",
  "description": "Per-site fonts, text size and language fonts for Chromium browsers.",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "wxt build && playwright test",
    "icons": "node scripts/render-icons.mjs",
    "store-assets": "wxt build && node scripts/render-store-assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
